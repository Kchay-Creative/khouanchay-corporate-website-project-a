# Development-only authentication. Never use these accounts in production.
DEV_AUTH_ENABLED=true
DEV_MANAGER_EMAIL=manager@example.test
DEV_MANAGER_PASSWORD=replace-with-unique-local-password
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=replace-with-unique-local-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Sliding development session policy. Idle lifetime cannot exceed maximum lifetime.
SESSION_IDLE_HOURS=336
SESSION_MAX_DAYS=90
SESSION_RENEWAL_MINUTES=720
